{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-watermark-generation",
  "main": "worker/src/index.js",
  // Always build the React app before deploying/serving, so frontend/dist is
  // never missing or stale (an unbuilt index.html loads /src/main.jsx and the
  // page stays blank).
  "build": { "command": "npm run build" },
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Per-IP limit on /api/upload: 30 uploads per 60 seconds
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Amazon S3 target. Set S3_BUCKET to enable "Upload to Amazon S3".
    // Credentials are secrets:  npx wrangler secret put AWS_ACCESS_KEY_ID
    //                           npx wrangler secret put AWS_SECRET_ACCESS_KEY
    // Recommended for a public URL: npx wrangler secret put UPLOAD_ACCESS_CODE
    "S3_BUCKET": "",
    "AWS_REGION": "ap-south-1",
    "S3_PREFIX": "watermarked/"
  }
}
